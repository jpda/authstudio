@inject OAuthBuilderActions BuilderActions
@inject NavigationManager NavigationManager
@implements IDisposable

<header class="app-header">
    <div class="app-header-brand">
        <NavLink href="" Match="NavLinkMatch.All" class="app-header-title">authstudio</NavLink>
        <span class="app-header-tagline">OAuth2 + PKCE debugger</span>
    </div>
    <nav class="app-header-nav">
        <NavLink href="" Match="NavLinkMatch.All" class="app-header-link">Builder</NavLink>
        <NavLink href="code" class="app-header-link">Callback</NavLink>
        <HeaderMenu Label="CIMD" Active="IsCimdActive">
            <NavLink href="cimd" Match="NavLinkMatch.All" class="header-menu-link">Document builder</NavLink>
            <NavLink href="cimd/lint" class="header-menu-link">Lint &amp; samples</NavLink>
        </HeaderMenu>
        <HeaderMenu Label="Tools" Active="IsToolsActive">
            <NavLink href="jwt" class="header-menu-link">JWT decoder</NavLink>
            <NavLink href="assertion" class="header-menu-link">private_key_jwt assertion</NavLink>
            <NavLink href="mcp" class="header-menu-link">MCP discovery</NavLink>
        </HeaderMenu>
        <NavLink href="about" class="app-header-link">About</NavLink>
    </nav>
    <div class="app-header-actions">
        <WidthToggle />
        <ThemeToggle />
        @if (BuilderActions.IsBuilderActive && BuilderActions.AuthorizeAsync is not null)
        {
            <button type="button" class="btn btn-primary btn-sm" @onclick="LaunchAuthorize">Authorize</button>
        }
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private bool IsCimdActive => IsSectionActive("cimd");

    private bool IsToolsActive => IsSectionActive("jwt", "assertion", "mcp");

    private bool IsSectionActive(params string[] prefixes)
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        return prefixes.Any(prefix => path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith($"{prefix}/", StringComparison.OrdinalIgnoreCase));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        StateHasChanged();
    }

    private async Task LaunchAuthorize()
    {
        if (BuilderActions.AuthorizeAsync is not null)
        {
            await BuilderActions.AuthorizeAsync();
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
