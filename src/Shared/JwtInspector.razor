@using System.Text.Json
@implements IDisposable
@inject JweDecryptionService JweDecryption
@inject JwtVerificationService JwtVerification
@inject IPersistentSettingsRepository SettingsRepository
@inject IWorkspaceSessionRepository WorkspaceSession
@inject NavigationManager NavigationManager
@inject HttpClient Http

@if (!string.IsNullOrWhiteSpace(Jwt))
{
    <div class="jwt-inspector" aria-label="@Label">
        @if (string.IsNullOrEmpty(NormalizedJwt))
        {
            <p class="panel-hint mb-0">No compact token after removing whitespace and a Bearer prefix.</p>
        }
        else
        {
            @if (TokenKind == CompactTokenKind.Jws && Verification is not null)
            {
                @RenderVerification(Verification)
            }

            <JwtView Token="@NormalizedJwt" />

            @if (TokenKind == CompactTokenKind.Jwe)
            {
                <div class="jwt-decrypt-panel">
                    <label for="@DecryptKeyId" class="form-label">Decryption key (private or symmetric JWK)</label>
                    <textarea id="@DecryptKeyId" class="form-control form-control-sm mono assertion-key-input" rows="4"
                        @bind="DecryptKeyJwk" @bind:after="PersistDecryptKey"></textarea>
                    <div class="panel-actions mt-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="UseBuilderKey">
                            Use builder key
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadIllustrativeKey">
                            Load illustrative key
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="DecryptJwe"
                            disabled="@(IsDecrypting || string.IsNullOrWhiteSpace(DecryptKeyJwk))">
                            @(IsDecrypting ? "Decrypting…" : "Decrypt")
                        </button>
                    </div>
                    <p class="panel-hint mb-0 mt-1">
                        Supports RSA-OAEP, ECDH-ES (+KW), dir, and AES-KW with A128/A192/A256GCM.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(DecryptError))
                {
                    <p class="panel-hint text-danger mb-1 mt-2">@DecryptError</p>
                }

                @if (DecryptedInnerKind == CompactTokenKind.Jws)
                {
                    <p class="panel-hint jwt-kind-badge mt-2 mb-1">Nested JWS inside JWE</p>
                    @if (InnerVerification is not null)
                    {
                        @RenderVerification(InnerVerification)
                    }
                    <JwtView Token="@DecryptedPlaintext" />
                }
                else if (!string.IsNullOrEmpty(DecryptedPlaintext))
                {
                    <h3 class="panel-subtitle">Decrypted plaintext</h3>
                    @if (DecryptedPretty is not null)
                    {
                        <JsonView Json="@DecryptedPretty" CssClass="jwt-json" />
                        <JwtTimeList Notes="@DecryptedTimes" />
                    }
                    else
                    {
                        <pre class="mono url-display jwt-json mb-0">@DecryptedPlaintext</pre>
                    }
                }
            }

            @if (!string.IsNullOrEmpty(JwtIoUrl))
            {
                <div class="panel-hint mt-2 mb-0">
                    <a href="@JwtIoUrl" target="tokeninfo" rel="noopener">jwt.io</a>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public string Jwt { get; set; } = "";

    [Parameter]
    public string Label { get; set; } = "JWT";

    [Parameter]
    public string JwtIoFragment { get; set; } = "token";

    [Parameter]
    public int VerificationDelayMilliseconds { get; set; }

    private string? DecryptError { get; set; }
    private List<KeyValuePair<string, string>> Claims { get; set; } = [];
    private string JwtIoUrl { get; set; } = "";
    private string NormalizedJwt { get; set; } = "";
    private CompactTokenKind TokenKind { get; set; }
    private CompactTokenKind DecryptedInnerKind { get; set; }
    private JwtVerificationResult? Verification { get; set; }
    private JwtVerificationResult? InnerVerification { get; set; }
    private string InspectedJws { get; set; } = "";
    private string DecryptKeyJwk { get; set; } = "";
    private string DecryptedPlaintext { get; set; } = "";
    private string? DecryptedPretty { get; set; }
    private IReadOnlyList<JwtTimeNote> DecryptedTimes { get; set; } = [];
    private bool IsDecrypting { get; set; }
    private bool IsVerifying { get; set; }
    private bool _initialized;
    private bool _decryptKeyLoaded;
    private bool _inner;
    private bool _disposed;
    private int _generation;
    private int _decryptGeneration;
    private CancellationTokenSource? _delayCts;
    private readonly CancellationTokenSource _lifetime = new();
    private string DecryptKeyId { get; } = $"jwt-decrypt-{Guid.NewGuid():N}";

    protected override async Task OnParametersSetAsync()
    {
        var normalized = JwtPresentation.Normalize(Jwt);
        if (_initialized && normalized == NormalizedJwt)
        {
            return;
        }

        var tokenChanged = normalized != NormalizedJwt;
        _initialized = true;
        NormalizedJwt = normalized;
        if (tokenChanged)
        {
            ResetDecodedState();
        }

        TokenKind = CompactToken.GetKind(NormalizedJwt);
        JwtIoUrl = string.IsNullOrEmpty(NormalizedJwt)
            ? ""
            : $"https://jwt.io/#{JwtIoFragment}={Uri.EscapeDataString(NormalizedJwt)}";
        Refresh();

        if (!_decryptKeyLoaded)
        {
            DecryptKeyJwk = await WorkspaceSession.GetDecryptionKeyJwkAsync() ?? "";
            _decryptKeyLoaded = true;
            if (_disposed)
            {
                return;
            }
        }

        if (TokenKind == CompactTokenKind.Jws)
        {
            await InspectJwsAsync(NormalizedJwt, outer: true);
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _generation++;
        _lifetime.Cancel();
        _delayCts?.Cancel();
        _lifetime.Dispose();
    }

    private void ResetDecodedState()
    {
        _generation++;
        _decryptGeneration++;
        _delayCts?.Cancel();
        Claims = [];
        DecryptError = null;
        Verification = null;
        InnerVerification = null;
        InspectedJws = "";
        DecryptedPlaintext = "";
        DecryptedPretty = null;
        DecryptedTimes = [];
        DecryptedInnerKind = CompactTokenKind.Invalid;
        IsVerifying = false;
        IsDecrypting = false;
        _inner = false;
    }

    private async Task InspectJwsAsync(string token, bool outer)
    {
        List<KeyValuePair<string, string>> claims;
        try
        {
            var decoded = JwtDecoder.Decode(token);
            claims = ClaimsFromPayload(decoded.Payload);
        }
        catch (FormatException)
        {
            ClearVerification(outer);
            return;
        }
        catch (JsonException)
        {
            ClearVerification(outer);
            return;
        }

        Claims = claims;
        InspectedJws = token;
        _inner = !outer;
        await VerifyJwsAsync(token, claims, outer, delay: true);
    }

    private static List<KeyValuePair<string, string>> ClaimsFromPayload(string payloadJson)
    {
        using var document = JsonDocument.Parse(payloadJson);
        if (document.RootElement.ValueKind != JsonValueKind.Object)
        {
            return [];
        }

        return CompactToken.ParseClaims(payloadJson);
    }

    private void ClearVerification(bool outer)
    {
        if (outer)
        {
            Verification = null;
        }
        else
        {
            InnerVerification = null;
        }
    }

    private async Task VerifyJwsAsync(
        string token,
        List<KeyValuePair<string, string>> claims,
        bool outer,
        bool delay)
    {
        var generation = _generation;
        if (delay && VerificationDelayMilliseconds > 0)
        {
            var delayToken = BeginDelay();
            try
            {
                await Task.Delay(VerificationDelayMilliseconds, delayToken);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            if (generation != _generation || _disposed)
            {
                return;
            }
        }

        IsVerifying = true;
        var pending = new JwtVerificationResult(JwtSignatureStatus.Verifying, "Checking signature…");
        if (outer)
        {
            Verification = pending;
        }
        else
        {
            InnerVerification = pending;
        }

        Refresh();

        var result = await JwtVerification.VerifyAsync(token, claims);
        if (generation != _generation || _disposed)
        {
            return;
        }

        if (outer)
        {
            Verification = result;
        }
        else
        {
            InnerVerification = result;
        }

        IsVerifying = false;
    }

    private CancellationToken BeginDelay()
    {
        _delayCts?.Cancel();
        var linked = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _delayCts = linked;
        return linked.Token;
    }

    private async Task DecryptJwe()
    {
        if (IsDecrypting || TokenKind != CompactTokenKind.Jwe)
        {
            return;
        }

        var generation = _decryptGeneration;
        DecryptError = null;
        Claims = [];
        InnerVerification = null;
        DecryptedPlaintext = "";
        DecryptedPretty = null;
        DecryptedTimes = [];
        DecryptedInnerKind = CompactTokenKind.Invalid;
        IsDecrypting = true;

        try
        {
            var plaintext = await JweDecryption.DecryptAsync(NormalizedJwt, DecryptKeyJwk);
            if (generation != _decryptGeneration || _disposed)
            {
                return;
            }

            DecryptedPlaintext = plaintext;
            await ApplyDecryptedContentAsync(plaintext);
            if (generation != _decryptGeneration || _disposed)
            {
                return;
            }

            await PersistDecryptKey();
        }
        catch (Exception ex)
        {
            if (generation != _decryptGeneration || _disposed)
            {
                return;
            }

            DecryptError = ex.Message;
        }
        finally
        {
            if (generation == _decryptGeneration)
            {
                IsDecrypting = false;
            }
        }
    }

    private async Task ApplyDecryptedContentAsync(string plaintext)
    {
        var trimmed = plaintext.Trim();
        var innerKind = CompactToken.GetKind(trimmed);
        DecryptedInnerKind = innerKind;

        if (innerKind == CompactTokenKind.Jws)
        {
            Refresh();
            await InspectJwsAsync(trimmed, outer: false);
            return;
        }

        try
        {
            DecryptedPretty = JwtDecoder.PrettyPrint(trimmed);
            DecryptedTimes = JwtPresentation.ReadTimeNotes(DecryptedPretty, DateTimeOffset.UtcNow);
        }
        catch (JsonException)
        {
            DecryptedPretty = null;
            DecryptedTimes = [];
        }
    }

    private async Task UseBuilderKey()
    {
        var client = await SettingsRepository.GetClientAppModelAsync();
        if (string.IsNullOrWhiteSpace(client?.SigningPrivateKeyJwk))
        {
            DecryptError = "No private JWK saved on the builder.";
            return;
        }

        DecryptKeyJwk = client.SigningPrivateKeyJwk;
        DecryptError = null;
        await PersistDecryptKey();
    }

    private async Task LoadIllustrativeKey()
    {
        DecryptError = null;
        try
        {
            DecryptKeyJwk = await Http.GetStringAsync(CimdDefaults.GetSigningKeyDocumentUrl(NavigationManager));
            await PersistDecryptKey();
        }
        catch (Exception ex)
        {
            DecryptError = ex.Message;
        }
    }

    private async Task PersistDecryptKey()
    {
        if (string.IsNullOrWhiteSpace(DecryptKeyJwk))
        {
            return;
        }

        await WorkspaceSession.SetDecryptionKeyJwkAsync(DecryptKeyJwk);
    }

    private async Task RetryVerification()
    {
        if (string.IsNullOrWhiteSpace(InspectedJws))
        {
            return;
        }

        _generation++;
        _delayCts?.Cancel();
        await VerifyJwsAsync(InspectedJws, Claims, outer: !_inner, delay: false);
    }

    private void Refresh()
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private RenderFragment RenderVerification(JwtVerificationResult verification) =>
        @<div class="jwt-verify">
            <div class="jwt-verify-row">
                <p class="jwt-sig-badge @SignatureBadgeClass(verification.Status) mb-0">@verification.Message</p>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RetryVerification"
                    disabled="@IsVerifying">
                    @(IsVerifying ? "Verifying…" : "Re-check signature")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(verification.JwksUri))
            {
                <p class="panel-hint jwt-jwks mb-0">
                    JWKS
                    <a href="@verification.JwksUri" target="_blank" rel="noopener" class="mono">@verification.JwksUri</a>
                </p>
            }
        </div>;

    private static string SignatureBadgeClass(JwtSignatureStatus status) => status switch
    {
        JwtSignatureStatus.Valid => "jwt-sig-valid",
        JwtSignatureStatus.Invalid => "jwt-sig-invalid",
        JwtSignatureStatus.Unsigned => "jwt-sig-unsigned",
        JwtSignatureStatus.Verifying => "jwt-sig-pending",
        _ => "jwt-sig-unknown"
    };
}
